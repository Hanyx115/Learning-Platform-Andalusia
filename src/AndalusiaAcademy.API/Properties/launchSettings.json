{
  "profiles": {
    "http": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "PUBLIC_URLS": "http://localhost:5022"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "http://localhost:5022"
    },
    "https": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "PUBLIC_URLS": "https://localhost:7105;http://localhost:5022"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7105;http://localhost:5022"
    },
    "Container (Dockerfile)": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/swagger",
      "environmentVariables": {
        "ASPNETCORE_HTTPS_PORTS": "8081",
        "ASPNETCORE_HTTP_PORTS": "8080",
        "PUBLIC_URLS": "https://localhost:7105;http://localhost:5022"
      },
      "httpPort": 5022,
      "sslPort": 7105,
      "publishAllPorts": false,
      "useSSL": true
    }
  },
  "$schema": "https://json.schemastore.org/launchsettings.json"
}

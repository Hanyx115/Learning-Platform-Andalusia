{
  "CatalogSeed": {
    "Enabled": true
  },
  "IdentitySeed": {
    "Enabled": true
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Authentication": {
    "RefreshCookie": {
      "Secure": false
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

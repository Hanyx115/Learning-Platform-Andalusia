{
  "CatalogSeed": {
    "Enabled": false
  },
  "IdentitySeed": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Authentication": {
    "RefreshCookie": {
      "Secure": false
    }
  },
  "RateLimiting": {
    "Authentication": {
      "LoginPermitLimit": 10000,
      "RegistrationPermitLimit": 10000,
      "RecoveryPermitLimit": 10000,
      "SessionPermitLimit": 10000
    }
  },
  "Notifications": {
    "ProcessingEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AndalusiaAcademy",
    "Audience": "AndalusiaAcademy.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Authentication": {
    "RefreshCookie": {
      "Name": "AndalusiaAcademy.RefreshToken",
      "Secure": true,
      "SameSite": "Strict"
    }
  },
  "RateLimiting": {
    "Authentication": {
      "LoginPermitLimit": 5,
      "LoginWindowSeconds": 60,
      "RegistrationPermitLimit": 5,
      "RegistrationWindowSeconds": 600,
      "RecoveryPermitLimit": 3,
      "RecoveryWindowSeconds": 900,
      "SessionPermitLimit": 30,
      "SessionWindowSeconds": 60
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "CatalogSeed": {
    "Enabled": false
  },
  "IdentitySeed": {
    "Enabled": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Notifications": {
    "ProcessingEnabled": true,
    "Health": {
      "UnhealthyAttemptCount": 5,
      "DegradedPendingCount": 100,
      "DegradedOldestMinutes": 5
    }
  },
  "CourseAssistant": {
    "Provider": "Demo",
    "OpenAI": {
      "Endpoint": "https://api.openai.com/v1/responses",
      "Model": "gpt-4.1-mini"
    }
  },
  "CourseMaterials": {
    "StoragePath": "App_Data/course-materials"
  },
  "CatalogImages": {
    "StoragePath": "App_Data/catalog-images"
  }
}

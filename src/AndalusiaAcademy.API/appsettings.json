{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AndalusiaAcademy",
    "Audience": "AndalusiaAcademy.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "CatalogSeed": {
    "Enabled": false
  },
  "IdentitySeed": {
    "Enabled": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Notifications": {
    "ProcessingEnabled": true,
    "Health": {
      "UnhealthyAttemptCount": 5,
      "DegradedPendingCount": 100,
      "DegradedOldestMinutes": 5
    }
  }
}

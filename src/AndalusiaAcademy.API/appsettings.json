{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AndalusiaAcademy",
    "Audience": "AndalusiaAcademy.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "CatalogSeed": {
    "Enabled": false
  },
  "IdentitySeed": {
    "Enabled": false
  },
  "HttpsRedirection": {
    "Enabled": true
  },
  "Notifications": {
    "ProcessingEnabled": true,
    "Health": {
      "UnhealthyAttemptCount": 5,
      "DegradedPendingCount": 100,
      "DegradedOldestMinutes": 5
    }
  },
  "CourseAssistant": {
    "Provider": "Demo",
    "OpenAI": {
      "Endpoint": "https://api.openai.com/v1/responses",
      "Model": "gpt-4.1-mini"
    }
  },
  "CourseMaterials": {
    "StoragePath": "App_Data/course-materials"
  },
  "CatalogImages": {
    "StoragePath": "App_Data/catalog-images"
  }
}
